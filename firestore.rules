rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveAdmin(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function validStudentStatus() {
      return request.resource.data.status in ['active', 'transferred', 'inactive'];
    }

    function validStudentAcademicPerformance() {
      return !request.resource.data.keys().hasAny(['academicPerformance'])
        || request.resource.data.academicPerformance in [
          'weak',
          'average',
          'good',
          'excellent'
        ];
    }

    function validAttendancePeriod() {
      return request.resource.data.period in ['morning', 'afternoon'];
    }

    function validAttendanceStatus() {
      return request.resource.data.status in [
        'present',
        'absent_excused',
        'absent_unexcused',
        'late'
      ];
    }

    function validAttendanceIncident() {
      return validAttendancePeriod()
        && request.resource.data.status in [
          'absent_excused',
          'absent_unexcused'
        ]
        && request.resource.data.expiresAt is timestamp;
    }

    function validChatMessage(classId) {
      return request.resource.data.keys().hasOnly([
          'text',
          'senderId',
          'senderName',
          'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName
          == get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.displayName
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
    }

    function validMathExerciseSet(classId) {
      return request.resource.data.keys().hasOnly([
          'title',
          'semester',
          'topicId',
          'topicLabel',
          'difficulty',
          'questionCount',
          'questions',
          'signature',
          'createdAt',
          'createdBy',
          'createdByName'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName
          == get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.displayName
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.semester in ['semester_1', 'semester_2']
        && request.resource.data.topicId is string
        && request.resource.data.topicLabel is string
        && request.resource.data.difficulty in ['basic', 'applied']
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount >= 1
        && request.resource.data.questionCount <= 15
        && request.resource.data.questions is list
        && request.resource.data.questions.size()
          == request.resource.data.questionCount
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0
        && request.resource.data.createdAt == request.time;
    }

    function validParentRepresentative() {
      return request.resource.data.keys().hasOnly([
          'fullName',
          'address',
          'phoneNumber',
          'position',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 150
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() > 0
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.position is string
        && request.resource.data.position.size() > 0
        && request.resource.data.position.size() <= 100
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validCalendarEvent() {
      return request.resource.data.keys().hasOnly([
          'title',
          'eventDate',
          'isAllDay',
          'startTime',
          'endTime',
          'category',
          'notes',
          'reminderMinutes',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.eventDate is string
        && request.resource.data.eventDate.size() == 10
        && request.resource.data.isAllDay is bool
        && (!request.resource.data.keys().hasAny(['startTime'])
          || (request.resource.data.startTime is string
            && request.resource.data.startTime.size() == 5))
        && (!request.resource.data.keys().hasAny(['endTime'])
          || (request.resource.data.endTime is string
            && request.resource.data.endTime.size() == 5))
        && request.resource.data.category in [
          'teaching',
          'meeting',
          'assessment',
          'personal',
          'other'
        ]
        && (!request.resource.data.keys().hasAny(['notes'])
          || (request.resource.data.notes is string
            && request.resource.data.notes.size() <= 3000))
        && (!request.resource.data.keys().hasAny(['reminderMinutes'])
          || (request.resource.data.reminderMinutes is int
            && request.resource.data.reminderMinutes >= 0
            && request.resource.data.reminderMinutes <= 10080))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /classes/{classId} {
      allow read: if isActiveAdmin(classId);
      allow create: if false;
      allow update: if isActiveAdmin(classId);
      allow delete: if false;

      match /members/{memberId} {
        allow read, create, update: if isActiveAdmin(classId);
        allow delete: if false;
      }

      match /subjects/{subjectId} {
        allow read, create, update: if isActiveAdmin(classId);
        allow delete: if false;
      }

      match /students/{studentId} {
        allow read: if isActiveAdmin(classId);
        allow create, update: if isActiveAdmin(classId)
          && validStudentStatus()
          && validStudentAcademicPerformance();
        allow delete: if isActiveAdmin(classId);
      }

      match /attendanceIncidents/{incidentId} {
        allow read: if isActiveAdmin(classId);
        allow create, update: if isActiveAdmin(classId)
          && validAttendanceIncident();
        allow delete: if isActiveAdmin(classId);
      }

      match /attendanceSessions/{sessionId} {
        allow read: if isActiveAdmin(classId);
        allow create, update: if isActiveAdmin(classId) && validAttendancePeriod();
        allow delete: if false;

        match /records/{studentId} {
          allow read: if isActiveAdmin(classId);
          allow create, update: if isActiveAdmin(classId) && validAttendanceStatus();
          allow delete: if false;
        }
      }

      match /lessonCheckCalls/{callId} {
        allow read, create, update: if isActiveAdmin(classId);
        allow delete: if false;
      }

      match /chatMessages/{messageId} {
        allow read: if isActiveAdmin(classId);
        allow create: if isActiveAdmin(classId)
          && validChatMessage(classId);
        allow update, delete: if false;
      }

      match /mathExerciseSets/{exerciseSetId} {
        allow read: if isActiveAdmin(classId);
        allow create: if isActiveAdmin(classId)
          && validMathExerciseSet(classId);
        allow update, delete: if false;
      }

      match /parentRepresentatives/{representativeId} {
        allow read: if isActiveAdmin(classId);
        allow create: if isActiveAdmin(classId)
          && validParentRepresentative()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isActiveAdmin(classId)
          && validParentRepresentative()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isActiveAdmin(classId);
      }

      match /calendarEvents/{eventId} {
        allow read: if isActiveAdmin(classId);
        allow create: if isActiveAdmin(classId)
          && validCalendarEvent()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if isActiveAdmin(classId)
          && validCalendarEvent()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isActiveAdmin(classId);
      }

      match /activityLogs/{logId} {
        allow read: if isActiveAdmin(classId);
        allow create: if isActiveAdmin(classId)
          && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
